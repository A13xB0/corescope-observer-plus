{
  "schema": 1,
  "id": "openhop.corescope_observer_plus",
  "name": "CoreScope Observer Plus",
  "version": "0.11.1",
  "description": "Polls repeater batteries and status for CoreScope, sharing the work with other observers so each repeater is polled once, by the closest.",
  "runtime": {
    "type": "python",
    "entrypoint": "openhop-corescope-observer-plus"
  },
  "ui": {
    "type": "application",
    "entry": "ui/index.html"
  },
  "config": {
    "defaults": {
      "openhop_api_url": "http://127.0.0.1:8000",
      "openhop_config_path": "/etc/openhop_repeater/config.yaml",
      "companion_name": "NeighbourBattery",
      "companion_port": 5003,
      "enabled": false,
      "interval_minutes": 60,
      "targets": [],
      "brokers": [],
      "max_age_hours": 24,
      "spacing_seconds": 20,
      "temperature_targets": [],
      "manual_repeaters": [],
      "corescope_url": "https://corescope.scotmesh.net",
      "max_hops": 0,
      "alternative_routes": false,
      "community": true
    }
  }
}
